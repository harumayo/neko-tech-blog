---
/** 特集画像ボックス：左に見出し＋チェックリスト、右に写真
 * <FeatureImage title="..." items={["a","b"]} img="/img/x.jpg" /> */
interface Props { title: string; items: string[]; img?: string; }
const { title, items, img } = Astro.props;
---
<div class="fi">
  <div class="fi__copy">
    <h3>{title}</h3>
    <ul>{items.map((i) => <li>{i}</li>)}</ul>
  </div>
  {img ? <img class="fi__img" src={img} alt={title} loading="lazy" /> : <div class="fi__img ph">写真</div>}
</div>
<style>
  .fi { display: grid; grid-template-columns: 1.15fr 1fr; overflow: hidden; border-radius: 10px; background: var(--surface-2); margin: 1.8em 0; }
  .fi__copy { padding: 22px 26px; }
  .fi__copy h3 { font-size: .98rem; margin: 0 0 10px; font-weight: 800; }
  .fi__copy ul { list-style: none; padding: 0; margin: 0; }
  .fi__copy li { position: relative; padding-left: 1.5em; font-size: .82rem; color: var(--ink-2); margin: 6px 0; }
  .fi__copy li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); font-weight: 800; }
  .fi__img { width: 100%; height: 100%; min-height: 200px; object-fit: cover; }
  @media (max-width: 640px) { .fi { grid-template-columns: 1fr; } .fi__img { order: -1; min-height: 180px; } }
</style>
