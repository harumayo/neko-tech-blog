---
/**
 * ランキング用の商品カード（ミニマル白基調・番号バッジ・絵文字なし）
 * 使い方(MDX):
 *   <RankCard rank={1} name="商品名" price="7,980円" rating={4.6}
 *     img="/img/product.jpg" href="https://link" label="Amazonで見る"
 *     catch="一番おすすめ" specs={[["画質","2K"]]} pros={["軽い"]} cons={["高い"]}>
 *     補足コメント
 *   </RankCard>
 */
interface Props {
  rank: number; name: string; price?: string; rating?: number;
  img?: string; href: string; label?: string; catch?: string;
  specs?: [string, string][]; pros?: string[]; cons?: string[];
}
const {
  rank, name, price, rating, img, href, label = '最新価格を見る',
  catch: catchCopy, specs = [], pros = [], cons = [],
} = Astro.props;
const rankClass = rank <= 3 ? `rank-${rank}` : 'rank-n';
const full = Math.floor(rating ?? 0);
const half = (rating ?? 0) - full >= 0.5;
---
<div class={`rc ${rankClass}`}>
  <div class="rc__badge"><span class="rc__no">{rank}</span><span class="rc__lab">位</span></div>

  <div class="rc__head rc__head--img">
    {img
      ? <img class="rc__img" src={img} alt={name} loading="lazy" />
      : <div class="rc__img rc__img--ph" aria-hidden="true">商品画像</div>}
    <div class="rc__meta">
      {catchCopy && <p class="rc__catch">{catchCopy}</p>}
      <p class="rc__name">{name}</p>
      {rating != null && (
        <p class="rc__stars" aria-label={`評価 ${rating} / 5`}>
          <span class="rc__starfill">{'★'.repeat(full)}{half ? '⯪' : ''}</span><span class="rc__starempty">{'☆'.repeat(Math.max(0, 5 - full - (half ? 1 : 0)))}</span>
          <span class="rc__score">{rating.toFixed(1)}</span>
        </p>
      )}
      {price && <p class="rc__price">参考価格 <strong>{price}</strong></p>}
    </div>
  </div>

  {specs.length > 0 && (
    <table class="rc__specs"><tbody>
      {specs.map(([k, v]) => (<tr><th>{k}</th><td>{v}</td></tr>))}
    </tbody></table>
  )}

  {(pros.length > 0 || cons.length > 0) && (
    <div class="rc__pc">
      {pros.length > 0 && (<div class="rc__pros"><p>良い点</p><ul>{pros.map((p) => <li>{p}</li>)}</ul></div>)}
      {cons.length > 0 && (<div class="rc__cons"><p>気になる点</p><ul>{cons.map((c) => <li>{c}</li>)}</ul></div>)}
    </div>
  )}

  <slot />

  <a class="rc__btn" href={href} rel="sponsored nofollow noopener" target="_blank">{label}</a>
  <p class="rc__pr">広告（アフィリエイト）を含みます</p>
</div>

<style>
  .rc { position: relative; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-sm); padding: 28px 24px 22px; margin: 2.4em 0; }
  .rc.rank-1 { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); box-shadow: var(--shadow); }

  .rc__badge { position: absolute; top: -15px; left: 22px; display: inline-flex; align-items: baseline; gap: 3px; background: var(--ink); color: #fff; border-radius: 999px; padding: 5px 14px; font-weight: 700; }
  .rc.rank-1 .rc__badge { background: var(--accent); }
  .rc__no { font-size: 1.05rem; line-height: 1; }
  .rc__lab { font-size: .72rem; }

  .rc__head { }
  .rc__head--img { display: grid; grid-template-columns: 150px 1fr; gap: 20px; align-items: center; }
  .rc__img { width: 150px; height: 150px; object-fit: contain; border-radius: 10px; background: var(--surface-2); }
  .rc__img--ph { display: grid; place-items: center; color: var(--ink-soft); font-size: .8rem; border: 1px dashed var(--line); }
  .rc__catch { display: inline-block; font-size: .8rem; font-weight: 700; color: var(--accent-ink); background: var(--accent-soft); padding: 3px 12px; border-radius: 999px; margin: 0 0 8px; }
  .rc__name { font-weight: 700; font-size: 1.2rem; color: var(--ink); margin: 0 0 6px; line-height: 1.5; }
  .rc__stars { margin: 0 0 6px; font-size: 1.02rem; letter-spacing: 1px; }
  .rc__starfill { color: var(--gold); } .rc__starempty { color: var(--line); }
  .rc__score { color: var(--ink-soft); font-size: .85rem; margin-left: 8px; letter-spacing: 0; }
  .rc__price { margin: 0; font-size: .95rem; color: var(--ink-soft); }
  .rc__price strong { color: var(--ink); font-size: 1.05rem; }

  .rc__specs { width: 100%; border-collapse: collapse; margin: 18px 0 4px; font-size: .92rem; }
  .rc__specs th, .rc__specs td { border: 1px solid var(--line); padding: 8px 12px; text-align: left; }
  .rc__specs th { background: var(--surface-2); width: 34%; color: var(--ink); font-weight: 700; }

  .rc__pc { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0 4px; }
  .rc__pros, .rc__cons { border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 16px; }
  .rc__pros p, .rc__cons p { font-weight: 700; margin: 0 0 6px; font-size: .9rem; padding-left: 12px; position: relative; }
  .rc__pros p::before, .rc__cons p::before { content: ""; position: absolute; left: 0; top: .3em; width: 5px; height: 1em; border-radius: 2px; }
  .rc__pros p { color: var(--ok); } .rc__pros p::before { background: var(--ok); }
  .rc__cons p { color: var(--warn); } .rc__cons p::before { background: var(--warn); }
  .rc__pc ul { margin: 0; padding-left: 0; list-style: none; font-size: .9rem; }
  .rc__pc li { margin: .35em 0; position: relative; padding-left: 1.2em; }
  .rc__pc li::before { content: ""; position: absolute; left: .05em; top: .8em; width: 5px; height: 5px; border: none; border-radius: 50%; transform: none; }
  .rc__pros li::before { background: var(--ok); }
  .rc__cons li::before { background: var(--warn); }

  .rc__btn { display: block; text-align: center; margin: 20px auto 0; max-width: 360px; background: var(--accent); color: #fff; font-weight: 700; text-decoration: none; padding: 14px 22px; border-radius: 10px; transition: background .12s; }
  .rc__btn:hover { background: var(--accent-ink); color: #fff; }
  .rc__pr { text-align: center; font-size: .72rem; color: var(--ink-soft); margin: 8px 0 0; }

  @media (max-width: 560px) {
    .rc__head--img { grid-template-columns: 1fr; text-align: center; }
    .rc__img { margin-inline: auto; }
    .rc__pc { grid-template-columns: 1fr; }
  }
</style>
