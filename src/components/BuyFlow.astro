---
/** 購入導線の仕上げ：スマホ下部固定CTA＋3問診断モーダル
 * <BuyFlow products={[{id:'switch',name:'SwitchBot 見守りカメラ 3MP',price:'¥5,480〜'}]} /> */
interface P { id: string; name: string; price: string; }
interface Props { products: P[]; }
const { products } = Astro.props;
---
<!-- スマホ下部固定バー -->
<div class="purchase-bar">
  <button class="pbar-btn" data-open-diagnosis>あなたに合う商品を診断</button>
  <a class="pbar-btn pbar-btn--solid" href="#comparison-products">おすすめ商品を見る</a>
</div>

<!-- 診断モーダル -->
<div class="modal-backdrop" id="diagnosticModal" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="diagTitle">
    <div class="modal-top"><h2 id="diagTitle">あなたに合う見守り環境を診断</h2><button class="close" data-close-diagnosis aria-label="閉じる">×</button></div>
    <div class="progress"><i></i></div>
    <div class="question is-active"><h3>Q1. 平日はどのくらい家を空けますか？</h3><div class="choices"><button class="choice" data-value="short">5時間未満</button><button class="choice" data-value="long">5〜10時間くらい</button><button class="choice" data-value="verylong">10時間以上</button></div></div>
    <div class="question"><h3>Q2. 帰宅時間は不規則ですか？</h3><div class="choices"><button class="choice" data-value="regular">だいたい決まっている</button><button class="choice" data-value="irregular">残業・外出で不規則</button></div></div>
    <div class="question"><h3>Q3. 猫の年齢を教えてください</h3><div class="choices"><button class="choice" data-value="young">子猫</button><button class="choice" data-value="adult">成猫</button><button class="choice" data-value="senior">シニア猫</button></div></div>
    <div class="result"><h3>診断結果</h3><div class="result-card"><h3 data-result-title></h3><p data-result-text></p><div class="result-products" data-result-products></div><a class="pbar-btn pbar-btn--solid" href="#comparison-products" data-close-after style="margin-top:14px;display:inline-flex">比較表で詳しく見る →</a></div><p class="modal-note">この診断はサイト内のレビュー評価・比較軸をもとにした目安です。猫の性格や健康状態によって適した環境は異なります。</p></div>
  </div>
</div>

<style>
  .purchase-bar { display: none; }
  .pbar-btn { display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--accent); background: var(--surface); color: var(--accent-ink); border-radius: 8px; padding: 12px 14px; font-size: .84rem; font-weight: 700; cursor: pointer; text-decoration: none; }
  .pbar-btn--solid { background: var(--accent-ink); color: #fff; border-color: var(--accent-ink); }
  @media (max-width: 900px) {
    .purchase-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 60; display: flex; gap: 8px; padding: 10px; background: rgba(255,255,255,.96); backdrop-filter: blur(12px); border-top: 1px solid var(--line); }
    .purchase-bar .pbar-btn { flex: 1; }
  }
  @media (prefers-color-scheme: dark) { @media (max-width: 900px) { .purchase-bar { background: rgba(31,34,31,.96); } } }

  .modal-backdrop { position: fixed; inset: 0; background: rgba(29,35,31,.45); z-index: 80; display: none; align-items: center; justify-content: center; padding: 20px; }
  .modal-backdrop.is-open { display: flex; }
  .modal { width: min(600px, 100%); max-height: 90vh; overflow: auto; background: var(--surface); border-radius: 16px; box-shadow: 0 20px 70px rgba(0,0,0,.2); padding: 26px; }
  .modal-top { display: flex; justify-content: space-between; align-items: center; }
  .modal h2 { font-size: 1.35rem; margin: 0; letter-spacing: -.01em; }
  .modal h2::before, .modal h3::before { content: none !important; counter-increment: none !important; }
  .close { border: 0; background: var(--surface-2); border-radius: 50%; width: 34px; height: 34px; cursor: pointer; font-size: 1.1rem; color: var(--ink); }
  .progress { height: 5px; background: var(--surface-2); border-radius: 99px; margin: 20px 0; }
  .progress i { display: block; height: 100%; width: 33%; background: var(--accent); border-radius: 99px; transition: .25s; }
  .question { display: none; }
  .question.is-active { display: block; }
  .question h3 { font-size: 1.1rem; margin: 14px 0; }
  .choices { display: grid; gap: 10px; }
  .choice { border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-align: left; border-radius: 9px; padding: 14px 16px; cursor: pointer; font-size: .92rem; }
  .choice:hover { border-color: var(--accent); background: var(--surface-2); }
  .result { display: none; }
  .result.is-active { display: block; }
  .result > h3 { font-size: 1rem; margin: 0 0 10px; }
  .result-card { background: var(--mint); border-radius: 12px; padding: 20px; }
  .result-card > h3 { margin: 0 0 8px; font-size: 1.2rem; color: var(--accent-ink); }
  .result-card > p { font-size: .86rem; margin: 0; color: var(--ink-2); }
  .result-products { display: grid; gap: 10px; margin-top: 14px; }
  .result-product { display: flex; gap: 12px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 9px; padding: 10px 14px; }
  .result-product strong { font-size: .88rem; color: var(--ink); }
  .result-product small { display: block; color: var(--ink-soft); font-size: .76rem; }
  .modal-note { font-size: .68rem; color: var(--ink-soft); margin-top: 14px; }
  :global(body.no-scroll) { overflow: hidden; }
</style>

<script define:vars={{ products }}>
  const modal = document.getElementById('diagnosticModal');
  if (modal) {
    const byId = Object.fromEntries(products.map((p) => [p.id, p]));
    const openers = document.querySelectorAll('[data-open-diagnosis]');
    const closeBtn = modal.querySelector('[data-close-diagnosis]');
    const questions = [...modal.querySelectorAll('.question')];
    const progress = modal.querySelector('.progress i');
    const result = modal.querySelector('.result');
    const rTitle = modal.querySelector('[data-result-title]');
    const rText = modal.querySelector('[data-result-text]');
    const rProducts = modal.querySelector('[data-result-products]');
    let answers = [];
    const open = () => { modal.classList.add('is-open'); document.body.classList.add('no-scroll'); reset(); };
    const close = () => { modal.classList.remove('is-open'); document.body.classList.remove('no-scroll'); };
    const reset = () => { answers = []; questions.forEach((q, i) => q.classList.toggle('is-active', i === 0)); result.classList.remove('is-active'); progress.style.width = '33%'; };
    openers.forEach((el) => el.addEventListener('click', (e) => { e.preventDefault(); open(); }));
    closeBtn?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    questions.forEach((q, index) => q.querySelectorAll('.choice').forEach((btn) => btn.addEventListener('click', () => {
      answers[index] = btn.dataset.value;
      if (index < questions.length - 1) {
        questions[index].classList.remove('is-active');
        questions[index + 1].classList.add('is-active');
        progress.style.width = `${((index + 2) / questions.length) * 100}%`;
      } else showResult();
    })));
    function showResult() {
      questions.forEach((q) => q.classList.remove('is-active'));
      progress.style.width = '100%';
      result.classList.add('is-active');
      const long = answers[0] === 'long' || answers[0] === 'verylong';
      const irregular = answers[1] === 'irregular';
      const senior = answers[2] === 'senior';
      let title = 'バランス重視型';
      let text = '留守番中の安心と、日々の使いやすさを両立できる環境がおすすめです。';
      let ids = products.slice(0, 2).map((p) => p.id);
      if (senior) { title = 'シニア猫・見守り重視型'; text = '体調の変化に気づきやすく、長時間の留守番にも対応しやすい構成がおすすめです。'; ids = [products[0].id, products[products.length - 1].id]; }
      else if (long || irregular) { title = '留守番・安心重視型'; text = '家を空ける時間が長いほど、カメラ＋自動化で「見えない時間」を減らすのがおすすめです。'; ids = products.slice(0, 2).map((p) => p.id); }
      rTitle.textContent = title; rText.textContent = text;
      rProducts.innerHTML = ids.map((id) => { const p = byId[id]; return `<div class="result-product"><div><strong>${p.name}</strong><small>${p.price}</small></div></div>`; }).join('');
    }
    modal.querySelector('[data-close-after]')?.addEventListener('click', close);
  }
  // アンカースムーススクロール
  document.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
    const id = a.getAttribute('href'); if (id === '#') return;
    const t = document.querySelector(id); if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  }));
</script>
